# 複製此檔為 .env 後填入實際值：cp .env.example .env

# PostgreSQL
# 用 docker compose 執行時，POSTGRES_HOST 填 compose 的服務名稱 postgres，PORT 填 5432
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# CWA API
# HISTORY  例：https://codis.cwa.gov.tw/api/station
# PREDICT  例：https://opendata.cwa.gov.tw/api/v1/rest/datastore/
# REALTIME 例：https://www.cwa.gov.tw/V8/C/W/Observe/MOD/24hr/
CWA_WEATHER_HISTORY_URL=
CWA_WEATHER_PREDICT_URL=
CWA_WEATHER_REALTIME_URL=
# 中央氣象署開放資料平臺的授權碼（https://opendata.cwa.gov.tw 註冊取得）
CWA_TOKEN=

# 時區，例：Asia/Taipei
TIMEZONE=
